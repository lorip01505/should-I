# Copy this file to .env (same folder) and paste your key from https://aistudio.google.com/apikey
# Never commit .env to GitHub.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-key-here

# Optional: turn extras off (0) if the free quota runs low. Full trial = 9 AI calls, basic = 3.
TRIBUNAL_EVIDENCE=1
TRIBUNAL_REBUTTAL=1
TRIBUNAL_JURY=1
# TRIBUNAL_MODEL=gemini-flash-lite-latest
# Plan B when a model is overloaded: seconds to wait, then the models to try next, in order.
# TRIBUNAL_PATIENCE=6
# TRIBUNAL_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-flash-latest,gemini-flash-lite-latest
